@using Game.App.Enum
@using Game.Client.Services.Interfaces
@using Game.Core.Models
@using Game.SignalR.Connector
@using Microsoft.AspNetCore.SignalR.Client
@using Newtonsoft.Json

@inject IGameClientService GameService

@inherits SignalRClientComponent

@rendermode InteractiveWebAssembly

@page "/control"

<h3>Game Master</h3>

<button @onclick="StartGame" disabled="@(selectedQuestions.Values.All(selected => !selected))">Start Game</button>
<button @onclick="NextQuestion">Next Question</button>
<button @onclick="EndGame">End Game</button>
<button @onclick="ResetGame">Reset Game</button>
<button @onclick="ToggleShowCurrentQuestion">@(gamePlayerState.ShowQuestion ? "Hide" : "Show") Current Question</button>
<button @onclick="ToggleShowAnswer">@(gamePlayerState.ShowAnswer ? "Hide" : "Show") Answer</button>
<button @onclick="ToggleShowScores">@(gamePlayerState.ShowScore ? "Hide" : "Show") Scores</button>
<button @onclick="ToggleShowQrCode">@(gamePlayerState.ShowQrCode ? "Hide" : "Show") QR Code</button>
<button @onclick="Unregister">Unregister</button>

<h4>Questions</h4>
<input type="checkbox" checked="@selectAll" @onchange="ToggleSelectAll" /> Select All

@foreach (var group in questions.GroupBy(q => q.Category))
{
  var category = group.Key ?? "Uncategorized";
  var isCollapsed = collapsedCategories.TryGetValue(category, out var collapsed) && collapsed;
  var allSelected = group.All(q => selectedQuestions[q.Id]);
  var someSelected = group.Any(q => selectedQuestions[q.Id]);
  <div class="category-group">
    <button @onclick="() => ToggleCategoryCollapse(category)">
      @(isCollapsed ? "▶" : "▼") @category
    </button>
    @if (!isCollapsed)
    {
      <div>
        <input type="checkbox"
               checked="@allSelected"
               indeterminate="@(!allSelected && someSelected)"
               @onchange="e => ToggleSelectCategory(e, group.ToList())" />
        <label>Select All in @category</label>
      </div>
      <ul>
        @foreach (var question in group)
        {
          <li>
            <input type="checkbox" @bind="selectedQuestions[question.Id]" />
            @question.Text
          </li>
        }
      </ul>
    }
  </div>
}


<h4>Current Question</h4>
@if (currentQuestion != null)
{
  <h5>Category:</h5><p>@currentQuestion.Category</p>
  <p>
    @((MarkupString) currentQuestion.Text)
  </p>
  <ol type="A">
    @for (int i = 0; i < currentQuestion.Options.Count; i++)  
    {  
       var option = currentQuestion.Options[i];  
       var borderColor = i switch  
       {  
           0 => "red",  
           1 => "blue",  
           2 => "yellow",  
           3 => "green",  
           _ => "black"  
       };  
       <li style="border: 2px solid @borderColor; padding: 5px;">
        @((MarkupString) option.Text)
      </li>  
    }
  </ol>
  <p>@currentQuestion.Notes</p>
}
else
{
  <p>Prepare game.</p>
}

<h4>Player Answers</h4>
<ul>
  @if (players.Count == 0)
  {
    <li>No players connected.</li>
  }
  else
  {
    foreach (var player in players)
    {
      <li>@player.Name: @player.LastMessage</li>
    }
  }
</ul>

@code {
  private HubConnection? hubConnection;
  private List<Player> players = [];
  private Question? currentQuestion;
  private Dictionary<string, bool> collapsedCategories = new();
  private readonly List<Question> questions = new();
  private Dictionary<Guid, bool> selectedQuestions = new();
  private bool selectAll = false;
  private bool isRegistered = false;
  private GameState gameState = GameState.NotStarted;
  private GamePlayerState gamePlayerState = new();

  private static readonly string[] possibleAnswers = { "A", "B", "C", "D" };

  protected override async Task OnInitializedAsync()
  {
    AddOnEventListener<List<Player>>(HubEnpoints.PlayerListUpdated, (message) =>
    {
      players.Clear();
      players.AddRange(message);

    if (!isRegistered)
    {
      isRegistered = true;
      Send(HubEnpoints.RegisterGameMaster, null);
    }
    });

    AddOnEventListener<GameState>(HubEnpoints.StateUpdated, (message) => gameState = message);

    await InitializeAsync();

    await LoadAllQuestions();
  }

  private async Task StartGame()
  {
    var selected = questions.Where(q => selectedQuestions.ContainsKey(q.Id) && selectedQuestions[q.Id]).ToList();
    await GameService.StartGame(selected);
    await LoadCurrentQuestion();
  }

  private async Task NextQuestion()
  {
    await GameService.NextQuestion();
    await LoadCurrentQuestion();

    if (currentQuestion is null) await EndGame();
  }

  private async Task EndGame()
  {
    await GameService.EndGame();
    currentQuestion = null;
  }

  private async Task ResetGame()
  {
    await GameService.ResetGame();
  }

  private async Task ToggleShowScores()
  {
    gamePlayerState.ShowScore = !gamePlayerState.ShowScore;
    Send(HubEnpoints.GamePlayerUpdated, gamePlayerState);
    await GameService.ShowGameStats();
  }

  private async Task ToggleShowQrCode()
  {
    gamePlayerState.ShowQrCode = !gamePlayerState.ShowQrCode;
    Send(HubEnpoints.GamePlayerUpdated, gamePlayerState);
  }

  private void ToggleShowCurrentQuestion()
  {
    gamePlayerState.ShowQuestion = !gamePlayerState.ShowQuestion;
    Send(HubEnpoints.CurrentQuestionUpdated, currentQuestion);
    Send(HubEnpoints.GamePlayerUpdated, gamePlayerState);
  }

  private void ToggleShowAnswer()
  {
    gamePlayerState.ShowAnswer = !gamePlayerState.ShowAnswer;
    Send(HubEnpoints.GamePlayerUpdated, gamePlayerState);
  }

  private async Task LoadAllQuestions()
  {
    var loadedQuestions = await GameService.GetQuestions();
    questions.AddRange(loadedQuestions.OrderBy(q => q.Category));
    foreach (var question in loadedQuestions)
    {
      selectedQuestions[question.Id] = false;
    }
  }

  private async Task LoadCurrentQuestion()
  {
    currentQuestion = await GameService.GetCurrentQuestion();
  }

  private void ToggleSelectAll(ChangeEventArgs e)
  {
    if (e.Value == null) return;

    selectAll = (bool) e.Value;
    foreach (var key in selectedQuestions.Keys.ToList())
    {
      selectedQuestions[key] = selectAll;
    }
  }

  private void ToggleSelectCategory(ChangeEventArgs e, List<Question> categoryQuestions)
  {
    if (e.Value is bool isChecked)
    {
      foreach (var question in categoryQuestions)
      {
        selectedQuestions[question.Id] = isChecked;
      }
    }
  }

  private void ToggleCategoryCollapse(string category)
  {
    if (collapsedCategories.ContainsKey(category))
      collapsedCategories[category] = !collapsedCategories[category];
    else
      collapsedCategories[category] = true;
  }


  private void Unregister()
  {
    Send(HubEnpoints.RegisterGameMaster, null);
  }
}
