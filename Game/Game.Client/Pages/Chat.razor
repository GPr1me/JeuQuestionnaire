@using Game.App.Services.Interfaces
@using Game.Core.Models
@using Game.SignalR.Connector
@using Microsoft.AspNetCore.SignalR.Client
@using Newtonsoft.Json


@inherits SignalRClientComponent

@rendermode InteractiveWebAssembly

@page "/chat"

<h3>Chat</h3>

<div>
  <h4>Connected Users</h4>
  @foreach (var player in players)
  {
    <div style="display: flex; gap: 10px; background-color: lightblue; padding: 5px; margin: 5px;">
      <div>
        <strong>@player.Name</strong>
      </div>
      <div>
        <strong>Score:</strong> @player.Score
      </div>
      <div>
        <p>Msg:</p> @player.LastMessage
      </div>
    </div>
  }
</div>

<div>
  <h4>Chat History</h4>
  <p>@chatHistory</p>
</div>



<input @bind="message" placeholder="Type a message" />
<button @onclick="SendMessage">Send</button>
<button @onclick="Connect">Connect</button>

@code {
  private string chatHistory = "init";
  private List<Player> players = [];
  private string message = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    AddOnEventListener<List<Player>>(HubEnpoints.PlayerListUpdated, (message) =>
    {
      players.Clear();
      players.AddRange(message);
    });

    await InitializeAsync();
    Connect();
  }

  private void SendMessage()
  {
    Send(HubEnpoints.SendMessage, message);
    message = string.Empty;
  }

  private void Connect()
  {
    Send(HubEnpoints.RegisterPlayer, null);
  }
}
