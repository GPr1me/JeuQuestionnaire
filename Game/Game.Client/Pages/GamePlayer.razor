@using Game.App.Enum
@using Game.App.Services.Interfaces
@using Game.Client.Services.Interfaces
@using Game.Core.Models
@inject IGameClientService GameService

@rendermode InteractiveWebAssembly
@inherits SignalRClientComponent

@page "/play"
<h3>Jeu</h3>
<h4>@gameState.ToString()</h4>

@if (currentQuestion != null && gamePlayerState.ShowQuestion)
{
  <p>@((MarkupString) currentQuestion.Text)</p>
  <ol type="A">
    @for (int i = 0; i < currentQuestion.Options.Count; i++)
    {
      var option = currentQuestion.Options[i];
      var borderColor = i switch
      {
        0 => "red",
        1 => "blue",
        2 => "yellow",
        3 => "green",
        _ => "black"
      };
      <li style="background-color: @(currentQuestion.Options[i].IsCorrect && gamePlayerState.ShowAnswer ? borderColor : "none"); color: @(currentQuestion.Options[i].IsCorrect && gamePlayerState.ShowAnswer ? "white" : "black"); padding: 5px; margin: 5px; border: 2px solid @borderColor;">
        @((MarkupString) currentQuestion.Options[i].Text)
        @if (gamePlayerState.ShowChat)
        {
          <div style="display: flex; gap: 10px; background-color: lightblue; padding: 5px; margin: 5px;">
            @foreach (var player in GetPlayersWithLastMessageMatchingOptionIndex(i))
            {
              <div>
                <strong>@player.Name</strong>
              </div>
            }
          </div>
        }
      </li>
    }
  </ol>
}
else
{
  <p>Attente de la prochaine question...</p>
}

@if (gamePlayerState.ShowScore)
{
  foreach (var player in players)
  {
    <div style="display: flex; gap: 10px; background-color: lightblue; padding: 5px; margin: 5px;">
      <div>
        <strong>@player.Name</strong>
      </div>
      <div>
        <strong>Score:</strong> @player.Score
      </div>
    </div>
  }
}

@code {
  private Question? currentQuestion;
  private GameState? gameState;
  private GamePlayerState gamePlayerState = new();
  private List<Player> players = [];
  private bool isRegistered = true;

  private static readonly string[] possibleAnswers = { "A", "B", "C", "D" };

  protected override async Task OnInitializedAsync()
  {
    AddOnEventListener<GameState>(HubEnpoints.StateUpdated, (newState) =>
    {
      gameState = newState;
      if (isRegistered)
      {
        isRegistered = false;
        Send(HubEnpoints.UnregisterPlayer, null);
      }
    });
    AddOnEventListener<Question?>(HubEnpoints.CurrentQuestionUpdated, (question) => currentQuestion = question);
    AddOnEventListener<GamePlayerState>(HubEnpoints.GamePlayerUpdated, (state) => gamePlayerState = state);
    AddOnEventListener<List<Player>>(HubEnpoints.PlayerListUpdated, (message) =>
    {
      players.Clear();
      players.AddRange(message);
    });

    await InitializeAsync();
  }

  private IEnumerable<Player> GetPlayersWithLastMessageMatchingOptionIndex(int index)
  {
    return players.Where(player => player.LastMessage == possibleAnswers[index]);
  }
}
