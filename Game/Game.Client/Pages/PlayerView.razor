@using Game.App.Services.Interfaces
@using Game.Core.Models
@using Game.SignalR.Connector
@using Microsoft.AspNetCore.SignalR.Client
@using Newtonsoft.Json

@inherits SignalRClientComponent

@rendermode InteractiveWebAssembly

@page "/player"

@if (player is not null)
{
  <div style="display: flex; gap: 10px; background-color: lightblue; padding: 5px; margin: 5px;">
    <div>
      <strong>@player.Name</strong>
    </div>
    <div>
      <strong>Score:</strong> @player.Score
    </div>
    <div>
      <p>Msg:</p> @player.LastMessage
    </div>
  </div>

  <div style="display: flex; gap: 10px; justify-content: center; margin-top: 10px;">
    <button @onclick="clickRedButton" style="width: 40px; height: 40px; border-radius: 50%; background-color: red; border: none;"></button>
    <button @onclick="clickBlueButton" style="width: 40px; height: 40px; border-radius: 50%; background-color: blue; border: none;"></button>
    <button @onclick="clickYellowButton" style="width: 40px; height: 40px; border-radius: 50%; background-color: yellow; border: none;"></button>
    <button @onclick="clickGreenButton" style="width: 40px; height: 40px; border-radius: 50%; background-color: green; border: none;"></button>
  </div>
}
else
{
  <p>Loading...</p>
}

@code {
  private Player? player;
  private string id = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    AddOnEventListener<Player>("YourName", (message) =>
    {
      player = message;
      id = message.Id;
    });
    AddOnEventListener<List<Player>>(HubEnpoints.PlayerListUpdated, (message) =>
    {
      player = message.FirstOrDefault(p => p.Id == id);
    });

    await InitializeAsync();
  }

  private void clickRedButton()
  {
    Send(HubEnpoints.SendMessage, "A");
  }
  private void clickBlueButton()
  {
    Send(HubEnpoints.SendMessage, "B");
  }
  private void clickYellowButton()
  {
    Send(HubEnpoints.SendMessage, "C");
  }
  private void clickGreenButton()
  {
    Send(HubEnpoints.SendMessage, "D");
  }
}
