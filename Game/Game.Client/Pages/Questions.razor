@using Game.Client.ModelView
@using Game.Client.Services
@using Game.Core.Models
@inject IQuestionService QuestionService

@rendermode InteractiveWebAssembly

@page "/questions"
<h3>Manage Questions</h3>

@if (_questions == null)
{
  <p>Loading...</p>
}
else
{
  <ul>
    @foreach (var question in _questions)
    {
      <li>
        @question.Text
        <button @onclick="() => EditQuestion(question)">Edit</button>
        <button @onclick="() => DeleteQuestion(question.Id)">Delete</button>
      </li>
    }
  </ul>

  <button @onclick="AddNewQuestion" class="btn btn-success">Add New Question</button>
}

@if (_selectedQuestion.Question != null)
{
  <h4>@(_selectedQuestion.IsNew ? "Add New Question" : "Edit Question")</h4>
  <EditForm Model="_selectedQuestion.Question" OnValidSubmit="SaveQuestion">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
      <label for="text">Question Text:</label>
      <input id="text" @bind="_selectedQuestion.Question.Text" class="form-control" />
    </div>

    <div>
      <label>Options:</label>
      <fieldset>
        @foreach (var option in _selectedQuestion.Question.Options)
        {
          <div>
            <div class="d-flex align-items-center">
              <input type="radio" id="radio_@option.Id" name="correctOption" checked="@option.IsCorrect" @onchange="() => SetCorrectOption(option)" class="me-2" />
              <input type="text" id="text_@option.Id" @bind="option.Text" class="form-control" />
            </div>
          </div>
        }
      </fieldset>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <button type="button" @onclick="CancelEdit" class="btn btn-secondary">Cancel</button>
  </EditForm>
}

@code {
  private List<Question> _questions = new();
  private EditedQuestion _selectedQuestion = new();

  protected override async Task OnInitializedAsync()
  {
    await LoadQuestions();
  }

  private void SetCorrectOption(Answer answer)
  {
    if (_selectedQuestion.Question == null) return;

    foreach (var option in _selectedQuestion.Question.Options)
    {
      option.IsCorrect = answer.Id == option.Id;
    }
  }

  private async Task LoadQuestions()
  {
    _questions = await QuestionService.GetAll();
  }

  private void AddNewQuestion()
  {
    _selectedQuestion.Question = new Question
      {
        Id = Guid.NewGuid(),
        Text = string.Empty,
        Options =
        [
          new Answer { Id = Guid.NewGuid(), Text = "Option 1", IsCorrect = false },
          new Answer { Id = Guid.NewGuid(), Text = "Option 2", IsCorrect = false },
          new Answer { Id = Guid.NewGuid(), Text = "Option 3", IsCorrect = false },
          new Answer { Id = Guid.NewGuid(), Text = "Option 4", IsCorrect = false }
        ]
      };

    _selectedQuestion.IsNew = true;

    StateHasChanged();
  }

  private void EditQuestion(Question question)
  {
    _selectedQuestion.Question = question;
    _selectedQuestion.IsNew = false;
  }

  private async Task SaveQuestion()
  {
    if (_selectedQuestion.Question != null)
    {
      if (_selectedQuestion.IsNew)
      {
        await QuestionService.Create(_selectedQuestion.Question);
      }
      else
      {
        await QuestionService.Update(_selectedQuestion.Question);
      }

      CancelEdit();
      await LoadQuestions();
    }
  }

  private async Task DeleteQuestion(Guid id)
  {
    await QuestionService.Delete(id);
    await LoadQuestions();
    StateHasChanged();
  }

  private void CancelEdit()
  {
    _selectedQuestion.Question = null;
  }
}
