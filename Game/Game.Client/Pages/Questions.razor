@using Game.Client.Services
@using Game.Core.Models
@inject IQuestionService QuestionService

@rendermode InteractiveWebAssembly

@page "/questions"
<h3>Manage Questions</h3>

@if (_questions == null)
{
  <p>Loading...</p>
}
else
{
  <ul>
    @foreach (var question in _questions)
    {
      <li>
        @question.Text
        <button @onclick="() => EditQuestion(question)">Edit</button>
        <button @onclick="() => DeleteQuestion(question.Id)">Delete</button>
      </li>
    }
  </ul>

  <button @onclick="AddNewQuestion" class="btn btn-success">Add New Question</button>
}

@if (_selectedQuestion != null)
{
  <h4>@(_selectedQuestion.Id == Guid.Empty ? "Add New Question" : "Edit Question")</h4>
  <EditForm Model="_selectedQuestion" OnValidSubmit="SaveQuestion">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
      <label for="text">Question Text:</label>
      <input id="text" @bind="_selectedQuestion.Text" class="form-control" />
    </div>

    <div>
      <label>Options:</label>
      @for (int i = 0; i < _selectedQuestion.Options.Count; i++)
      {
        <div>
          <input type="radio" id="correctOption-@i" name="correctOption"
                 checked="@_selectedQuestion.Options[i].IsCorrect"
                 @onchange="() => SetCorrectOption(i)" />
          <input type="text" id="correctOption-@i" @bind="_selectedQuestion.Options[i].Text" class="form-control" />
        </div>
      }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <button type="button" @onclick="CancelEdit" class="btn btn-secondary">Cancel</button>
  </EditForm>
}

@code {
  private List<Question> _questions = new();
  private Question? _selectedQuestion;

  protected override async Task OnInitializedAsync()
  {
    await LoadQuestions();
  }

  private void SetCorrectOption(int index)
  {
    if (_selectedQuestion == null) return;

    for (int i = 0; i < _selectedQuestion.Options.Count; i++)
    {
      _selectedQuestion.Options[i].IsCorrect = (i == index);
    }
  }

  private async Task LoadQuestions()
  {
    _questions = await QuestionService.GetAll();
    _selectedQuestion = _questions.FirstOrDefault();
  }

  private void AddNewQuestion()
  {
    _selectedQuestion = new Question
      {
        Id = Guid.Empty,
        Text = string.Empty,
        Options =
          [
            new Answer { Id = Guid.NewGuid(), Text = "Option 1", IsCorrect = true },
          new Answer { Id = Guid.NewGuid(), Text = "Option 2", IsCorrect = false },
          new Answer { Id = Guid.NewGuid(), Text = "Option 3", IsCorrect = false },
          new Answer { Id = Guid.NewGuid(), Text = "Option 4", IsCorrect = false }
          ]
      };

    StateHasChanged();
  }

  private void EditQuestion(Question question)
  {
    // Clone the question to avoid modifying the list directly
    _selectedQuestion = new Question
      {
        Id = question.Id,
        Text = question.Text,
        Options = question.Options
      };
  }

  private async Task SaveQuestion()
  {
    if (_selectedQuestion != null)
    {
      if (_selectedQuestion.Id == Guid.Empty)
      {
        await QuestionService.Create(_selectedQuestion);
      }
      else
      {
        await QuestionService.Update(_selectedQuestion);
      }

      await LoadQuestions();
    }
  }

  private async Task DeleteQuestion(Guid id)
  {
    await QuestionService.Delete(id);
    await LoadQuestions();
    StateHasChanged();
  }

  private void CancelEdit()
  {
    _selectedQuestion = null;
  }

  private string OptionsAsString
  {
    get => string.Join(", ", _selectedQuestion?.Options.Select(o => o.Text) ?? Array.Empty<string>());
    set
    {
      if (_selectedQuestion != null)
      {
        _selectedQuestion.Options = value.Split(',')
            .Select(text => new Answer { Id = Guid.NewGuid(), Text = text.Trim(), IsCorrect = false })
            .ToList();
      }
    }
  }
}
